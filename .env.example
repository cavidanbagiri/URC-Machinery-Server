# Copy to server/.env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------------
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=urc_machinery

# Render (or another host) may provide a single URL instead of DB_* vars.
# DATABASE_URL=postgresql://user:password@host:5432/database

# --- JWT --------------------------------------------------------------------
# Generate strong independent secrets, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256

# --- Cookies ----------------------------------------------------------------
# Production: leave as true/none (HTTPS cross-site).
# Local HTTP development: set COOKIE_SECURE=false (SameSite falls back to lax).
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# --- CORS -------------------------------------------------------------------
# Comma-separated origins; omit to use localhost:5173 + the Render web app.
# CORS_ORIGINS=http://localhost:5173,https://urc-machinery-web.onrender.com

# --- Object storage (Cloud.ru S3) -------------------------------------------
# Machine photos are uploaded by the backend; only the object key is stored in
# PostgreSQL. Cloud.ru rejects anonymous GETs ("missing tenant id"), so keep
# S3_PUBLIC_BASE_URL empty and the API returns presigned URLs. Fill it in only
# when the bucket really serves objects without signing.
S3_ENDPOINT=https://s3.cloud.ru
S3_REGION=ru-central-1
# Cloud.ru access keys look like "<tenant_id>:<key_id>".
S3_ACCESS_KEY_ID=your-tenant-id:your-key-id
S3_SECRET_ACCESS_KEY=your-key-secret
S3_BUCKET=urc-machinery-images
# Public base URL, e.g. https://s3.cloud.ru/urc-machinery-images (path style)
# or https://urc-machinery-images.s3.cloud.ru (virtual-host style).
S3_PUBLIC_BASE_URL=
S3_ADDRESSING_STYLE=path
S3_MAX_UPLOAD_MB=10
# Only used when S3_PUBLIC_BASE_URL is empty. Maximum: 604800 (7 days).
# S3_PRESIGN_EXPIRES_SECONDS=86400

